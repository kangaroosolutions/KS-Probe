# KS-Probe — Environment Variables
# Copy to .env and fill in your keys. Never commit .env to git.

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...

# ── xAI (Grok) ───────────────────────────────────────────────────────────────
XAI_API_KEY=xai-...

# ── DeepSeek ──────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...

# ── Perplexity ────────────────────────────────────────────────────────────────
PPLX_API_KEY=pplx-...

# ── Self-hosted vLLM (Llama 4 Maverick / Scout) ───────────────────────────────
VLLM_BASE_URL=http://localhost:8000

# ── Database (leave blank to use SQLite default) ──────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/ks_probe_results

# ── Experiment settings ───────────────────────────────────────────────────────
# Cost confirmation threshold in USD (runs exceeding this require manual OK)
COST_CONFIRM_THRESHOLD=500

# Max concurrent API calls per provider
MAX_CONCURRENT=4
